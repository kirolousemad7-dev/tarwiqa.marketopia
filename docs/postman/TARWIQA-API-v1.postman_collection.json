      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const payload = pm.response.json();",
                  "  pm.collectionVariables.set('jwt_token', payload.data.token);",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@tarwiqa.test\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{api_base}}/auth/login",
              "host": [
                "{{api_base}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Authenticates an active account and returns a signed JWT."
          },
          "response": []
        },
        {
